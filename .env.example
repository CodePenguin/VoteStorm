# Real-time updates (Ably). Required. The key needs Publish, Subscribe and Presence.
ABLY_API_KEY=

# Database (libSQL/Turso). Required when hosting. Leave blank locally to use a SQLite file (data/local-dev.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Licensing (REQUIRED, no defaults). Create the values with (see "Initial setup" in the README):
#   npm run license -- setup --issuer https://licenses.example.com
#   npm run license -- mint --anonymous --issuer https://licenses.example.com --hours 24 --max-questions 50 --max-audience 500 --max-storms 100
# See docs/licensing.md.
ALLOWED_LICENSE_ISSUERS=
LICENSE_JWKS_JSON=
ANONYMOUS_LICENSE_JWT=
# LICENSE_CLAIM_NAMESPACE=
# LICENSE_AUDIENCE=
