# Real-time updates (Ably). Required. The key needs Publish, Subscribe and Presence.
ABLY_API_KEY=

# Database (libSQL/Turso). Required when hosting. Leave blank locally to use a SQLite file (data/local-dev.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Licensing (all optional; see docs/licensing.md).
# ALLOWED_LICENSE_ISSUERS=https://licenses.example.com
# LICENSE_JWKS_JSON={"keys":[...]}
# LICENSE_CLAIM_NAMESPACE=
# LICENSE_AUDIENCE=
# ANONYMOUS_LICENSE_JSON={"roomInactivityHours":24}
